{
  "workflow": "barseq_ct2_v1",
  "root": "${BARSEQ_ROOT}",
  "run": "${RUN}",
  "python": "${BARSEQ_ROOT}/envs/celltransformer2-v1/bin/python",
  "rapids_python": "${BARSEQ_ROOT}/envs/rapids-24.12/bin/python",
  "epochs": 10,
  "n_genes": 106,
  "batch_size": 256,
  "max_tokens": 16384,
  "patch_width_um": 310.0,
  "workers": 0,
  "seed": 42,
  "threads": 8,
  "device": "cuda",
  "storage_reserve_gib": 20,
  "split": "within_section",
  "validation_fraction": 0.05,
  "log_every": 100,
  "software_test": false,
  "model": {
    "_target_": "celltransformer.model.SpatialCellTransformer",
    "expression_dim": 106,
    "cell_type_cardinality": 46,
    "model_dim": 384,
    "encoder_depth": 4,
    "decoder_depth": 4,
    "num_heads": 8,
    "ffn_dim": 384,
    "concat_mode": "add",
    "use_zi": true,
    "use_diagonal_norm": true,
    "nb_proj_eps": 0.0001,
    "dropout": 0.0,
    "multiple_of": 256,
    "norm_eps": 1e-05,
    "init_std_attn_pool": 0.02,
    "compile": false
  },
  "optimization": {
    "lr": 0.0003,
    "weight_decay": 1e-08,
    "schedule_warmup": 500,
    "schedule_timescale": 5000,
    "accumulate_grad_batches": 1,
    "max_epochs": 10,
    "precision": "bf16-mixed"
  },
  "smoothing": {
    "sigma_um": 100.0,
    "k": 500,
    "includes_self": true
  },
  "metric_neighbors": 100,
  "initialization": "random; all weights trained",
  "epoch_definition": "Every eligible training center exactly once; incomplete final batch retained",
  "export_checkpoint": "last completed epoch, not best validation checkpoint",
  "adaptations": [
    "Single GPU, finite full epochs, cached native-equivalent neighborhoods, 106 released sequencing targets, unused and hybridization channels excluded, local logging, section-safe memory-bounded smoothing"
  ],
  "input_transform": "log2(raw molecule counts + 1)",
  "reference_use": "Evaluation only; never input as training label",
  "source_manifest_sha256": "1a18efdedd9a8f64ced795005a0b3aaf524dca35deffd24e2e7d3b6de2a60b68"
}
